{
  "name": "mediadown",
  "version": "1.0.0",
  "description": "Aplikasi pengunduh media sosial performa tinggi berbasis **yt-dlp** & **FFmpeg** dengan antarmuka web modern responsif (React).",
  "main": "index.js",
  "scripts": {
    "server_dev": "npm run dev --prefix backend",
