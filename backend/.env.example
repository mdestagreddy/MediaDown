# MediaDown Backend Configuration
# Copy to .env and adjust values as needed

# Server settings
PORT=5000
DOWNLOADS_DIR=downloads
MAX_CONCURRENT=4

# Media engines (point to your installed binaries)
YT_DLP=ytdlp
GALLERY_DL=gallery-dl
FFMPEG=ffmpeg

# yt-dlp options
YTDLP_USERNAME=
YTDLP_PASSWORD=
YTDLP_COOKIE_FILE=
YTDLP_PROXY=

# gallery-dl options
GALLERY_DL_USERNAME=
GALLERY_DL_PASSWORD=
GALLERY_DL_COOKIE_FILE=
GALLERY_DL_PROXY=

# Cleanup
CLEANUP_INTERVAL_MIN=15
TTL_MINUTES=15

# Cloudflare Turnstile (anti-bot) - get keys at https://dash.cloudflare.com/
# Set TURNSTILE_SECRET_KEY to enable verification on /api/info and /api/image-info
TURNSTILE_SECRET_KEY=
